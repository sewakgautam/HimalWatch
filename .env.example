# Copernicus Data Space Ecosystem — https://dataspace.copernicus.eu/
# Free account. Used by packages/pipeline's Sentinel-2 extraction
# (build_composite in extract/lakes.py and extract/glaciers.py) to obtain
# an OAuth2 token. Never commit real values — this file is tracked,
# .env is not.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# Firebase service account key (JSON), used only by CI
# (.github/workflows/pipeline.yml) to publish the static bundle after a
# pipeline run — stored as the FIREBASE_SERVICE_ACCOUNT GitHub secret, not
# read from this file. See README.md for how to generate it. Not needed
# for local development unless you're testing a deploy.
